# Agent API MCP runtime environment.
#
# Copy to .env for local development. In hosted deployments, provide these as
# real environment variables; process env values override .env file values.

# ---------------------------------------------------------------------------
# Externally supplied by deployment layer
# ---------------------------------------------------------------------------
#
# In the parent docker-compose stack these values are supplied by
# deployments/docker-compose/.env and overlay.public-edge.yml. Keep them
# commented here for composed runs. Uncomment and set them for independent MCP
# deployment.
#
# Agent API upstream used by this MCP server.
# AGENT_API_MCP_UPSTREAM_BASE_URL=https://api.example.com

# Public authorization server URL advertised to MCP clients. Defaults to
# AGENT_API_MCP_UPSTREAM_BASE_URL when unset.
# AGENT_API_MCP_AUTHORIZATION_SERVER_URL=https://api.example.com

# Public MCP origin advertised in protected-resource metadata. Leave commented
# to derive it from Host/X-Forwarded-* headers.
# AGENT_API_MCP_PUBLIC_BASE_URL=https://mcp.example.com

# MCP upstream Agent API request timeout in milliseconds. Defaults to 600000.
# AGENT_API_MCP_HTTP_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Module-local settings
# ---------------------------------------------------------------------------

# Hosted MCP HTTP bind address. Defaults to :8080.
AGENT_API_MCP_ADDR=:8080

# Streamable HTTP MCP path. Defaults to /mcp.
AGENT_API_MCP_PATH=/mcp

# MCP session timeout in milliseconds. Defaults to 1800000.
AGENT_API_MCP_SESSION_TIMEOUT_MS=1800000
