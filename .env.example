# Agent API MCP runtime environment.
#
# Copy to .env for local development. In hosted deployments, provide these as
# real environment variables; process env values override .env file values.

# Agent API upstream used by this MCP server. For a managed remote MCP service,
# this is normally the public Agent API base URL.
AGENT_API_MCP_UPSTREAM_BASE_URL=https://api.example.com

# Public authorization server URL advertised to MCP clients. This is an MCP
# metadata reference to the platform auth origin; defaults to
# AGENT_API_MCP_UPSTREAM_BASE_URL.
AGENT_API_MCP_AUTHORIZATION_SERVER_URL=

# Public MCP origin advertised in protected-resource metadata. Leave empty for
# plain local development to derive it from Host/X-Forwarded-* headers.
AGENT_API_MCP_PUBLIC_BASE_URL=

# Hosted MCP HTTP bind address. Defaults to :8080.
AGENT_API_MCP_ADDR=:8080

# Streamable HTTP MCP path. Defaults to /mcp.
AGENT_API_MCP_PATH=/mcp

# MCP upstream Agent API request timeout in milliseconds. Defaults to 600000.
AGENT_API_MCP_HTTP_TIMEOUT_MS=600000

# MCP session timeout in milliseconds. Defaults to 1800000.
AGENT_API_MCP_SESSION_TIMEOUT_MS=1800000
