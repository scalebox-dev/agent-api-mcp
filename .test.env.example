AGENT_API_BASE_URL=https://api.agentsway.dev
AGENT_API_KEY=sk-...
AGENT_API_MCP_TEST_URL=https://mcp.agentsway.dev/mcp

# Remote MCP test level:
# - smoke: connect, list tools, and call lightweight read-only catalog tools.
# - agent: smoke plus one real Agent API response run.
# - full: reserved for broader workload coverage such as volumes, memory, skills,
#   and multiple agent presets.
AGENT_API_MCP_TEST_LEVEL=smoke
